# Optional GUS X-ClientId. Leave unset for the conservative unauthenticated client.
GUS_CLIENT_ID=
# Local development value only; choose your own password for other environments.
POSTGRES_PASSWORD=region_demo_local_only
REGION_DATA_MODE=snapshot
# PostgreSQL mode uses DATABASE_URL; the demo snapshot needs no database.
DATABASE_URL=postgresql+psycopg://region:region_demo_local_only@127.0.0.1:55432/region_comparison
